generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Proposal {
  id          Int     @id @default(autoincrement())
  name        String
  days        Day[]
  steps       Step[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Day {
  id          Int     @id @default(autoincrement())
  order       Int
  name        String
  proposalId  Int
  stepId      Int?
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  step        Step?    @relation(fields: [stepId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Step {
  id          Int     @id @default(autoincrement())
  order       Int
  name        String
  proposalId  Int
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  days        Day[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
